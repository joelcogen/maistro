{
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "board_id": {
      "type": "string",
      "description": "The database UUID: the id of the matching list_databases entry, used as database_id for row and field tools. Never the board view UUID."
    },
    "view_id": {
      "type": "string",
      "description": "The board view UUID from the matched database entry's views, distinct from board_id."
    },
    "matches": {
      "type": "integer",
      "description": "Number of database/board candidates matching the configured URL or page name. Exactly one for an unambiguous board. This is never a count of stories, rows, statuses or tools."
    },
    "complete": {
      "type": "boolean"
    },
    "fields_readable": {
      "type": "boolean"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "story_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "ready",
              "in_progress",
              "review",
              "done",
              "blocked",
              "cancelled"
            ]
          },
          "priority": {
            "type": "integer"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "implement",
              "blocked",
              "ignore"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "story_id",
          "title",
          "description",
          "status",
          "priority",
          "dependencies",
          "acceptance_criteria",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_id",
    "workspace_id",
    "board_id",
    "view_id",
    "matches",
    "complete",
    "fields_readable",
    "stories"
  ],
  "additionalProperties": false
}
