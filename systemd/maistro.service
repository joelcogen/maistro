[Unit]
Description=Maistro AppFlowy coding orchestrator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
EnvironmentFile=%h/.config/maistro/environment
ExecStart=%h/.local/bin/maistro --config %h/.config/maistro/config.toml run
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
