[Unit]
Description=Maistro AppFlowy coordinator and project workers
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
# Override PATH/environment in a user service drop-in for custom toolchains.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
EnvironmentFile=-%h/.config/maistro/environment
ExecStart=%h/.local/bin/maistro --config %h/.config/maistro/config.toml run
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
